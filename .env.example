# ============================================================
# Patriot Pest Control - Environment Configuration (TEMPLATE)
# ------------------------------------------------------------
# Copy this file to `.env` and fill in REAL values.
#   Windows:  copy .env.example .env
# The `.env` file is git-ignored and must NEVER be committed.
# All keys are read by app/Core/Config.php via a safe parser.
# ============================================================

# --- Application ---
# APP_ENV: "local" | "staging" | "production"
# APP_DEBUG: "true" shows detailed errors (local only). MUST be "false" in production.
# APP_URL: canonical site URL (no trailing slash). Used for canonical tags + links.
# APP_KEY: a long random string used to sign/encrypt sensitive data. Generate with:
#          php -r "echo bin2hex(random_bytes(32));"
APP_ENV=local
APP_DEBUG=true
APP_URL=https://patriotpest.pro
APP_KEY=replace_with_64_char_random_hex_string

# --- Database (SQLite) ---
# DB_PATH is relative to the project root. The file is auto-created + migrated.
DB_DRIVER=sqlite
DB_PATH=database/patriot.db

# --- Mail (used to send login OTP codes + reactivation campaigns) ---
# Patriot uses Titan email (smtp.titan.email) in production.
MAIL_HOST=smtp.titan.email
MAIL_PORT=465
MAIL_SECURITY=ssl
MAIL_USERNAME=your-sender@patriotpest.pro
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_NAME=Patriot Pest Control
MAIL_FROM_ADDRESS=david@itak.live

# --- Twilio (phone intelligence + verified SMS for reactivation) ---
# Lookup v2 uses Account SID + Auth Token (HTTP basic).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15095551234
TWILIO_SMS_ENABLED=true
# Optional: API key/secret (preferred over auth token for new integrations)
TWILIO_API_KEY=
TWILIO_API_SECRET=

# --- FieldRoutes (source of truth for customers; multi-district) ---
# Live per-district keys/tokens are stored encrypted in the DB (districts table),
# NOT here. These are only fallbacks / connection defaults.
FIELDROUTES_BASE_URL=https://patriotpestc.fieldroutes.com
FIELDROUTES_WA_KEY=
FIELDROUTES_WA_TOKEN=
FIELDROUTES_AZ_KEY=
FIELDROUTES_AZ_TOKEN=

# --- Supabase (blog comments only - optional) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- AI content generation (blog drafting via n8n / direct API) ---
# Used by the admin CMS "generate with AI" feature.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o
# Optional n8n webhook that triggers automated blog generation:
N8N_WEBHOOK_URL=

# --- Session / security tuning ---
# Idle timeouts in seconds (overridable from the admin dashboard).
SESSION_LIFETIME_CUSTOMER=900
SESSION_LIFETIME_STAFF=7200
# --- Superuser login (dedicated elevated surface, separate from /login) ---
# Toggleable: when false, /su and /su/verify return 404 (default).
SUPERUSER_ENABLED=false
# OTP validity for superuser codes (seconds, shorter than staff default).
SU_OTP_TTL=300
# Seed email — the account promoted to superuser on first migration.
SU_SEED_EMAIL=david@itak.live

# OTP validity (seconds) + max attempts before lockout.
OTP_TTL=600
OTP_MAX_ATTEMPTS=5
# Superuser OTP: shorter window, tighter attempt cap (purpose-aware, see OtpAuth::maxAttemptsFor).
SU_OTP_MAX_ATTEMPTS=3

# --- Analytics (Google Analytics 4 + Google Ads via gtag.js) ---
# GTAG_ID: your GA4 measurement id (G-…). Leave blank if you only run Ads.
# GADS_ID: your Google Ads conversion id (AW-…).
# FB_PIXEL_ID: Meta/Facebook Pixel id (13-16 digits).
# MS_CLARITY_ID: Microsoft Clarity project id (8-12 chars).
# Emitted only when an id is set AND not in local dev (or ANALYTICS_ENABLED=true).
GTAG_ID=
GADS_ID=AW-18082646992
FB_PIXEL_ID=
MS_CLARITY_ID=
ANALYTICS_ENABLED=false

# --- Geo phone localization ---
# Visitors from Arizona see the AZ line; everyone else sees the main WA line.
# Set GEO_FORCE_REGION to "wa" or "az" to preview a region locally (blank=auto).
GEO_FORCE_REGION=
API_ENABLED=false

# --- Facebook Lead Ads webhook ---
# Facebook app secret used to validate X-Hub-Signature-256 on incoming webhooks.
FACEBOOK_APP_SECRET=
# Long-lived page access token for Graph API lead data retrieval.
FACEBOOK_PAGE_ACCESS_TOKEN=
# Verify token string set during Facebook webhook subscription; must match.
FACEBOOK_HUB_VERIFY_TOKEN=

# --- Lead SMS notification (email-to-SMS carrier gateway) ---
# Target: Verizon gateway for 509-666-4121 (Skyler's cell).
# Set LEAD_SMS_ENABLED=true once A2P 10DLC registration is complete.
LEAD_SMS_ENABLED=false
LEAD_SMS_TO=5096664121@vtext.com
LEAD_SMS_FROM=PPC_Info@patriotpest.pro
LEAD_SMS_BYPASS_DNC=true
LEAD_EMAIL_TO=PPC_Info@patriotpest.pro
# Titan SMTP credentials for email-to-SMS dispatch (port 587, STARTTLS).
LEAD_SMTP_HOST=smtp.titan.email
LEAD_SMTP_PORT=587
LEAD_SMTP_SECURITY=tls
LEAD_SMTP_USERNAME=PPC_Info@patriotpest.pro
LEAD_SMTP_PASSWORD=
